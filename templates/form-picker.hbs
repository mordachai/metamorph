<div class="metamorph-picker-inner">
  {{#if isFilterView}}

  <div class="mm-picker-filters">
    {{#if baseActor}}
    <div class="mm-filter-tile mm-filter-tile-base" data-actor-id="{{baseActor.actorId}}" data-action="pickForm">
      <span class="mm-filter-tile-name">{{baseActor.label}}</span>
      <span class="mm-filter-tile-count mm-hint">base</span>
    </div>
    {{/if}}
    {{#each sections}}
    <div class="mm-filter-tile" data-filter-id="{{filterId}}" data-action="selectFilter">
      <span class="mm-filter-tile-name">{{filterName}}</span>
      <span class="mm-filter-tile-count mm-hint">{{count}}</span>
    </div>
    {{/each}}
  </div>

  {{else}}

  <div class="mm-picker-actors">
    {{#if hasBack}}
    <div class="mm-picker-back" data-action="back">
      <i class="fa-solid fa-chevron-left"></i>
      <span>{{filterName}}</span>
    </div>
    {{/if}}
    <div class="mm-picker-grid">
      {{#each actors}}
      <div class="mm-form-portrait {{#if active}}active{{/if}} {{#if isBase}}mm-form-base{{/if}}"
           data-actor-id="{{actorId}}" {{#if packId}}data-pack-id="{{packId}}"{{/if}} data-action="pickForm">
        <img src="{{img}}" alt="{{label}}">
        <span class="mm-form-label">{{label}}</span>
      </div>
      {{/each}}
    </div>
  </div>

  {{/if}}
</div>
