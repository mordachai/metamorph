<div class="mm-cfg-layout">

  {{!-- LEFT: Actor folder tree --}}
  <div class="mm-cfg-left">

    {{#each folders}}
    <div class="mm-cfg-folder" data-folder-id="{{id}}">
      <div class="mm-cfg-folder-hdr" data-action="toggleFolder">
        <i class="fa-solid fa-chevron-right mm-cfg-chevron"></i>
        <span class="mm-cfg-folder-name">{{name}}</span>
      </div>
      <div class="mm-cfg-folder-body">
        {{#each actors}}
        <div class="mm-cfg-actor-row {{#if selected}}selected{{/if}} {{#if hasGroups}}has-groups{{/if}}"
             data-actor-id="{{id}}" data-action="selectActor" title="{{name}}"
             draggable="true" data-actor-name="{{name}}" data-actor-img="{{img}}">
          <img src="{{img}}" alt="{{name}}">
          <span class="mm-cfg-actor-name">{{name}}</span>
          {{#if hasGroups}}<i class="fa-solid fa-check mm-cfg-check"></i>{{/if}}
        </div>
        {{/each}}
      </div>
    </div>
    {{/each}}

    {{#each ungrouped}}
    <div class="mm-cfg-actor-row {{#if selected}}selected{{/if}} {{#if hasGroups}}has-groups{{/if}}"
         data-actor-id="{{id}}" data-action="selectActor" title="{{name}}"
         draggable="true" data-actor-name="{{name}}" data-actor-img="{{img}}">
      <img src="{{img}}" alt="{{name}}">
      <span class="mm-cfg-actor-name">{{name}}</span>
      {{#if hasGroups}}<i class="fa-solid fa-check mm-cfg-check"></i>{{/if}}
    </div>
    {{/each}}

  </div>

  {{!-- RIGHT --}}
  <div class="mm-cfg-right">

    {{!-- Tab navigation --}}
    <nav class="mm-cfg-tabs">
      <button type="button" class="mm-cfg-tab {{#if (eq activeTab 'actors')}}active{{/if}}"
              data-action="switchTab" data-tab="actors"><i class="fa-solid fa-user-check"></i> Actors</button>
      <button type="button" class="mm-cfg-tab {{#if (eq activeTab 'groups')}}active{{/if}}"
              data-action="switchTab" data-tab="groups"><i class="fa-solid fa-layer-group"></i> Groups</button>
      <button type="button" class="mm-cfg-tab {{#if (eq activeTab 'filters')}}active{{/if}}"
              data-action="switchTab" data-tab="filters"><i class="fa-solid fa-filter"></i> Filters</button>
      <button type="button" class="mm-cfg-tab {{#if (eq activeTab 'tutorial')}}active{{/if}}"
              data-action="switchTab" data-tab="tutorial"><i class="fa-solid fa-graduation-cap"></i> Tutorial</button>
    </nav>

    {{!-- ── Actors tab ── --}}
    {{#if (eq activeTab 'actors')}}
    <div class="mm-cfg-tab-body">
      {{#if actorPanel}}

      <div class="mm-cfg-actor-hdr">
        <span class="mm-cfg-sec-title">{{actorPanel.actorName}}</span>
        <label class="mm-cfg-hp-label"><i class="fa-solid fa-heart-pulse"></i> HP on swap
          <select name="hpMode">
            {{#each actorPanel.hpModes}}
            <option value="{{value}}" {{#if (eq value ../actorPanel.hpMode)}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      </div>

      {{!-- ── Actor Forms (direct sets) ── --}}
      <div class="mm-cfg-section-hdr">
        <span class="mm-cfg-sec-title"><i class="fa-solid fa-users"></i> Actor Forms</span>
        <button type="button" data-action="addActorSet" class="mm-cfg-icon-btn mm-cfg-sec-btn">
          <i class="fa-solid fa-plus"></i> Add Set
        </button>
      </div>

      {{#if actorPanel.directSets.length}}
      <div class="mm-cfg-direct-sets">
        {{#each actorPanel.directSets}}
        <div class="mm-cfg-direct-set" data-set-id="{{id}}">
          <div class="mm-cfg-set-hdr">
            <input type="text" class="mm-cfg-set-name" value="{{name}}"
                   placeholder="Set name" data-set-id="{{id}}">
            <button type="button" data-action="removeActorSet" data-set-id="{{id}}"
                    title="Delete set" class="mm-cfg-grp-del">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
          <div class="mm-cfg-set-drop" data-set-id="{{id}}">
            {{#each actors}}
            <div class="mm-cfg-set-actor" title="{{name}}">
              <img src="{{img}}" alt="{{name}}">
              <span class="mm-cfg-set-actor-name">{{name}}</span>
              <button type="button" data-action="removeActorFromSet"
                      data-set-id="{{../id}}" data-actor-id="{{actorId}}"
                      {{#if packId}}data-pack-id="{{packId}}"{{/if}}
                      title="Remove" class="mm-cfg-set-actor-del">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            {{/each}}
            {{#unless actors.length}}
            <p class="mm-cfg-drop-hint"><i class="fa-solid fa-arrow-down"></i> Drop actors here</p>
            {{/unless}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="hint mm-cfg-empty mm-cfg-drop-nudge">
        No actor forms yet. Click <strong>Add Set</strong>, name it, then drag actors from the list on the left.
      </p>
      {{/if}}

      {{!-- ── Morph Groups ── --}}
      <div class="mm-cfg-section-hdr mm-cfg-section-hdr--gap">
        <span class="mm-cfg-sec-title"><i class="fa-solid fa-layer-group"></i> Morph Groups</span>
      </div>

      {{#if actorPanel.groups.length}}
      <div class="mm-cfg-group-checks">
        {{#each actorPanel.groups}}
        <label class="mm-cfg-group-check-row">
          <input type="checkbox" class="mm-cfg-actor-group-cb" data-group-id="{{id}}"
                 {{#if assigned}}checked{{/if}}>
          <span class="mm-cfg-group-check-name">{{name}}</span>
        </label>
        {{/each}}
      </div>
      {{else}}
      <p class="hint mm-cfg-empty">No morph groups yet — create one in the <strong>Groups</strong> tab.</p>
      {{/if}}

      {{else}}
      <p class="hint mm-cfg-prompt">Select an actor to configure their morph access.</p>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Groups tab ── --}}
    {{#if (eq activeTab 'groups')}}
    <div class="mm-cfg-tab-body">
      <div class="mm-cfg-tab-toolbar">
        <button type="button" data-action="addGroup" class="mm-cfg-icon-btn">
          <i class="fa-solid fa-plus"></i> New Group
        </button>
      </div>

      {{#if morphGroups.length}}
      {{#each morphGroups}}
      <div class="mm-cfg-grp-acc {{#if open}}open{{/if}}" data-group-id="{{id}}">

        <div class="mm-cfg-grp-hdr">
          <button type="button" class="mm-cfg-grp-toggle" data-action="toggleGroup" data-group-id="{{id}}"
                  title="Expand / collapse">
            <i class="fa-solid fa-chevron-right mm-cfg-chevron"></i>
          </button>
          <input type="text" class="mm-cfg-group-name" value="{{name}}"
                 placeholder="Group name" data-group-id="{{id}}">
          <span class="mm-hint mm-cfg-grp-count">({{presets.length}})</span>
          <button type="button" data-action="removeGroup" data-group-id="{{id}}"
                  title="Delete group" class="mm-cfg-grp-del">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>

        <div class="mm-cfg-grp-body">
          {{#each presets}}
          <div class="mm-cfg-grp-filter-row">
            <span class="mm-cfg-grp-filter-name">{{name}}</span>
            <span class="mm-hint">({{count}})</span>
            <button type="button" data-action="removeFilterFromGroup"
                    data-group-id="{{../id}}" data-preset-id="{{id}}"
                    title="Remove from group" class="mm-cfg-grp-filter-del">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>
          {{/each}}

          <div class="mm-cfg-grp-add-row">
            {{#if availablePresets.length}}
            <select class="mm-cfg-filter-select" data-group-id="{{id}}">
              <option value="">— Add existing filter —</option>
              {{#each availablePresets}}
              <option value="{{id}}">{{name}} ({{count}})</option>
              {{/each}}
            </select>
            {{/if}}
            <button type="button" data-action="newFilterForGroup" data-group-id="{{id}}"
                    class="mm-cfg-icon-btn">
              <i class="fa-solid fa-plus"></i> New Filter
            </button>
          </div>

          <div class="mm-cfg-grp-actors-hdr">
            <span class="mm-hint">Direct actors <span class="mm-cfg-grp-count">({{actors.length}})</span></span>
          </div>
          <div class="mm-cfg-set-drop" data-group-id="{{id}}">
            {{#each actors}}
            <div class="mm-cfg-set-actor" title="{{name}}">
              <img src="{{img}}" alt="{{name}}">
              <span class="mm-cfg-set-actor-name">{{name}}</span>
              <button type="button" data-action="removeActorFromGroup"
                      data-group-id="{{../id}}" data-actor-id="{{actorId}}"
                      {{#if packId}}data-pack-id="{{packId}}"{{/if}}
                      title="Remove" class="mm-cfg-set-actor-del">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            {{/each}}
            {{#unless actors.length}}
            <p class="mm-cfg-drop-hint"><i class="fa-solid fa-arrow-down"></i> Drop actors here to share a fixed list — no filter needed</p>
            {{/unless}}
          </div>
        </div>

      </div>
      {{/each}}
      {{else}}
      <p class="hint mm-cfg-empty">No morph groups. Click <strong>New Group</strong> to create one.</p>
      {{/if}}
    </div>
    {{/if}}

    {{!-- ── Filters tab ── --}}
    {{#if (eq activeTab 'filters')}}
    <div class="mm-cfg-tab-body">

      {{#if editingPreset}}
      {{!-- Filter editor (full tab takeover) --}}
      <div class="mm-cfg-preset-edit">
        <div class="mm-cfg-edit-title">
          {{#if editingPreset.id}}Edit: <em>{{editingPreset.name}}</em>{{else}}New Filter Preset{{/if}}
        </div>
        <div class="mm-fp-edit">
          <div class="mm-fp-field">
            <label>Name</label>
            <input type="text" name="fp-name" value="{{editingPreset.name}}"
                   placeholder="e.g. Druid Beasts CR≤2" autofocus>
          </div>
          <fieldset class="mm-fp-fieldset">
            <legend>Sources</legend>
            {{#each editingPreset.sourcesAvailable}}
            <label class="mm-fp-check-row">
              <input type="checkbox" name="fp-source" value="{{id}}" {{#if checked}}checked{{/if}}>
              {{label}}
            </label>
            {{/each}}
          </fieldset>
          <fieldset class="mm-fp-fieldset">
            <legend>Actor type <em class="mm-hint">(Foundry type, e.g. npc)</em></legend>
            <div class="mm-fp-field">
              <input type="text" name="fp-actorTypes" value="{{editingPreset.criteriaActorTypes}}"
                     placeholder="npc, character  (comma-separated, blank = any)">
            </div>
          </fieldset>
          <fieldset class="mm-fp-fieldset mm-fp-rules-fieldset">
            <legend>Field rules <em class="mm-hint">(all must match)</em></legend>
            <div class="mm-fp-rules-header">
              <span class="mm-fp-col-label mm-hint">Field path</span>
              <span class="mm-fp-col-label mm-hint">Value  (prefix &lt;= &gt;= &lt; &gt; for numbers)</span>
            </div>
            <div class="mm-fp-rules">
              {{#each editingPreset.criteria.rules}}
              <div class="mm-fp-rule">
                <input type="text" name="fp-rule-path"  value="{{path}}"
                       placeholder="system.details.cr" class="mm-fp-rule-path">
                <input type="text" name="fp-rule-value" value="{{value}}"
                       placeholder="&lt;=2  or  beast"  class="mm-fp-rule-value">
                <button type="button" data-action="removeRule" title="Remove rule">
                  <i class="fa-solid fa-xmark"></i>
                </button>
              </div>
              {{/each}}
            </div>
            <button type="button" data-action="addRule" class="mm-fp-add-rule">
              <i class="fa-solid fa-plus"></i> Add rule
            </button>
          </fieldset>
        </div>
        <footer class="mm-cfg-edit-footer">
          <button type="button" data-action="cancelEdit">Cancel</button>
          <button type="button" data-action="savePreset">Save Preset</button>
        </footer>
      </div>

      {{else}}
      {{!-- Filter list --}}
      <div class="mm-cfg-tab-toolbar">
        <button type="button" data-action="newPreset" class="mm-cfg-icon-btn">
          <i class="fa-solid fa-plus"></i> New Filter
        </button>
      </div>
      {{#if allPresets.length}}
      {{#each allPresets}}
      <div class="mm-cfg-preset-row" data-preset-id="{{id}}">
        <span class="mm-cfg-preset-name">{{name}}</span>
        <span class="mm-hint mm-cfg-preset-count">({{count}})</span>
        <button type="button" data-action="editPreset"      data-preset-id="{{id}}" title="Edit">
          <i class="fa-solid fa-pencil"></i>
        </button>
        <button type="button" data-action="duplicatePreset" data-preset-id="{{id}}" title="Duplicate">
          <i class="fa-solid fa-copy"></i>
        </button>
        <button type="button" data-action="deletePreset"    data-preset-id="{{id}}" title="Delete">
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
      {{/each}}
      {{else}}
      <p class="hint mm-cfg-empty">No filter presets. Click <strong>New Filter</strong> to create one.</p>
      {{/if}}
      {{/if}}

    </div>
    {{/if}}

    {{!-- ── Tutorial tab ── --}}
    {{#if (eq activeTab 'tutorial')}}
    <div class="mm-cfg-tab-body mm-cfg-tutorial">

      <p class="mm-cfg-tut-intro">Two ways to give an actor multiple forms. Use either or both together.</p>

      {{!-- Path A: Actor Forms --}}
      <div class="mm-cfg-tut-step-title" style="margin-bottom:6px;">
        <i class="fa-solid fa-users"></i> Path A — Actor Forms <span class="mm-hint">(hand-picked, best for boss phases)</span>
      </div>

      <div class="mm-cfg-tut-step">
        <div class="mm-cfg-tut-step-num">1</div>
        <div class="mm-cfg-tut-step-body">
          <div class="mm-cfg-tut-step-title">
            <i class="fa-solid fa-user-check"></i> Select an Actor
          </div>
          <p class="mm-cfg-tut-step-desc">
            Click any actor in the left panel. Go to the <strong>Actors</strong> tab.
            At the top you'll see the <strong>Actor Forms</strong> section.
          </p>
        </div>
      </div>

      <div class="mm-cfg-tut-step">
        <div class="mm-cfg-tut-step-num">2</div>
        <div class="mm-cfg-tut-step-body">
          <div class="mm-cfg-tut-step-title">
            <i class="fa-solid fa-plus"></i> Add a Set and Drag Actors In
          </div>
          <p class="mm-cfg-tut-step-desc">
            Click <strong>Add Set</strong>, give it a name (e.g. <em>Boss Phases</em>),
            then drag actors from the left panel — or from the Foundry actor sidebar —
            onto the drop zone. Each set appears as its own tile in the HUD picker.
            Actors are stored directly; no filters needed.
          </p>
          <p class="mm-cfg-tut-step-desc">
            Actor Forms are <strong>per-actor</strong> and not shared. Ideal for unique
            encounters: specific boss phases, named NPC variants, summoned forms.
          </p>
        </div>
      </div>

      <div class="mm-cfg-tut-divider"></div>

      {{!-- Path B: Filters + Groups --}}
      <div class="mm-cfg-tut-step-title" style="margin-bottom:6px;">
        <i class="fa-solid fa-filter"></i> Path B — Filter Groups <span class="mm-hint">(query-based, best for druids / polymorphs)</span>
      </div>

      <div class="mm-cfg-tut-step">
        <div class="mm-cfg-tut-step-num">1</div>
        <div class="mm-cfg-tut-step-body">
          <div class="mm-cfg-tut-step-title">
            <i class="fa-solid fa-filter"></i> Create a Filter
          </div>
          <p class="mm-cfg-tut-step-desc">
            Go to the <strong>Filters</strong> tab → <strong>New Filter</strong>. Pick a
            source (World and/or a compendium), optionally restrict by actor type, then
            add field rules to narrow the results.
          </p>
          <p class="mm-cfg-tut-step-desc">
            Field paths depend on your game system. Right-click an actor in the sidebar →
            <strong>Export Data</strong> and open the <code>.json</code> file — the
            structure maps directly to the field paths you enter here.
            The examples below use D&amp;D 5e paths.
          </p>
          <div class="mm-cfg-tut-examples-label">Examples <span class="mm-hint">(D&amp;D 5e)</span></div>
          <div class="mm-cfg-tut-examples">
            <div class="mm-cfg-tut-example">
              <span class="mm-cfg-tut-ex-name">CR ≤ 2 Beasts</span>
              <span class="mm-hint">Type: <code>npc</code> &nbsp;·&nbsp;
                <code>system.details.type.value</code> = <code>beast</code> &nbsp;·&nbsp;
                <code>system.details.cr</code> = <code>&lt;=2</code>
              </span>
            </div>
            <div class="mm-cfg-tut-example">
              <span class="mm-cfg-tut-ex-name">All World NPCs</span>
              <span class="mm-hint">Source: World &nbsp;·&nbsp; Type: <code>npc</code> &nbsp;·&nbsp; no field rules</span>
            </div>
            <div class="mm-cfg-tut-example">
              <span class="mm-cfg-tut-ex-name">Humanoids CR ≤ 4</span>
              <span class="mm-hint">Type: <code>npc</code> &nbsp;·&nbsp;
                <code>system.details.type.value</code> = <code>humanoid</code> &nbsp;·&nbsp;
                <code>system.details.cr</code> = <code>&lt;=4</code>
              </span>
            </div>
            <div class="mm-cfg-tut-example">
              <span class="mm-cfg-tut-ex-name">Player Characters</span>
              <span class="mm-hint">Source: World &nbsp;·&nbsp; Type: <code>character</code> &nbsp;·&nbsp; no field rules</span>
            </div>
          </div>
        </div>
      </div>

      <div class="mm-cfg-tut-step">
        <div class="mm-cfg-tut-step-num">2</div>
        <div class="mm-cfg-tut-step-body">
          <div class="mm-cfg-tut-step-title">
            <i class="fa-solid fa-layer-group"></i> Create a Group
          </div>
          <p class="mm-cfg-tut-step-desc">
            Go to the <strong>Groups</strong> tab → <strong>New Group</strong> → name it →
            expand it → add filters via the dropdown or <strong>New Filter</strong>.
            Groups are <strong>global</strong> — the same group can be assigned to multiple actors
            (two druids in the party sharing one "Wild Shapes" group).
          </p>
          <p class="mm-cfg-tut-step-desc">
            No filter needed? Drag actors straight onto the <strong>Direct actors</strong> drop
            zone under the filter list — a fixed shared list, same as Actor Forms but global.
            Each character who morphs into a shared form gets their own private copy, named
            <em>Character (Form)</em> on the sheet; the token itself always keeps showing the
            character's own name.
          </p>
        </div>
      </div>

      <div class="mm-cfg-tut-step">
        <div class="mm-cfg-tut-step-num">3</div>
        <div class="mm-cfg-tut-step-body">
          <div class="mm-cfg-tut-step-title">
            <i class="fa-solid fa-user-check"></i> Assign to an Actor
          </div>
          <p class="mm-cfg-tut-step-desc">
            Select an actor from the left panel, go to the <strong>Actors</strong> tab,
            and tick the groups they should access under <strong>Morph Groups</strong>.
            A checkmark <i class="fa-solid fa-check" style="font-size:10px;color:var(--control-active-border-color,var(--color-warm-2))"></i>
            appears on their name once configured.
          </p>
        </div>
      </div>

      <div class="mm-cfg-tut-divider"></div>

      {{!-- HP on Swap --}}
      <div class="mm-cfg-tut-hp-section">
        <div class="mm-cfg-tut-step-title">
          <i class="fa-solid fa-heart-pulse"></i> HP on Swap
        </div>
        <p class="mm-cfg-tut-step-desc">
          Set per-actor in the <strong>Actors</strong> tab. Controls what happens to
          hit points when the token changes form.
        </p>
        <div class="mm-cfg-tut-hp-grid">
          <div class="mm-cfg-tut-hp-mode">
            <span class="mm-cfg-tut-hp-name">Independent</span>
            <span class="mm-hint">Each form keeps its own HP. Swapping back restores the original value.</span>
          </div>
          <div class="mm-cfg-tut-hp-mode">
            <span class="mm-cfg-tut-hp-name">Keep original HP</span>
            <span class="mm-hint">The new form inherits the flat HP value the actor had before the swap.</span>
          </div>
          <div class="mm-cfg-tut-hp-mode">
            <span class="mm-cfg-tut-hp-name">Carry over (absolute)</span>
            <span class="mm-hint">Copies the current HP number to the new form, clamped to its max.</span>
          </div>
          <div class="mm-cfg-tut-hp-mode">
            <span class="mm-cfg-tut-hp-name">Carry over (percent)</span>
            <span class="mm-hint">Preserves the HP ratio — e.g. 60 % HP stays 60 % on the new form.</span>
          </div>
        </div>
      </div>

    </div>
    {{/if}}

  </div>
</div>
